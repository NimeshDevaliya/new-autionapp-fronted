# Base URL of the backend REST API. "localhost" is swapped for the page's own
# host automatically when the app is opened from another device on the network,
# so this works for http://<this-machine-ip>:3000 too.
NEXT_PUBLIC_API_URL=http://localhost:3005/api

# WebSocket endpoint for live auction events (same host substitution applies)
NEXT_PUBLIC_WS_URL=ws://localhost:3005/ws

# Extra hosts allowed to open the dev server, besides this machine's own LAN
# addresses which are detected automatically. Comma-separated. Dev only.
# NEXT_DEV_ALLOWED_ORIGINS=
